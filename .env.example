# Single env file for the whole project. Copy to .env and adjust — defaults already work.
#
# Used by:
#   - the backend, when run manually (`cd backend && uv run uvicorn ...`)
#   - the frontend, when run manually (`cd frontend && npm run dev`)
#   - docker-compose.yml / docker-compose.dev.yml, which load this file (`env_file: .env`)
#     and pass its values into the backend/frontend containers. A few values are
#     overridden per-service in the compose files where the containerized context needs a
#     different value (the `postgres`/`backend` service hostnames, etc).

# --- Docker (prod) ---
# Port the app is published on for LAN colleagues, e.g. http://<this-machine-ip>:FRONTEND_PORT
# Change this if port 80 is already taken on the host.
FRONTEND_PORT=80

# --- Backend ---
APP_NAME="Asset Management API"
API_PREFIX=/api
# Credentials for the postgres service in docker-compose*.yml, and for DATABASE_URL below
# when running the backend manually against a local Postgres instance.
POSTGRES_USER=accounting
POSTGRES_PASSWORD=changeme
POSTGRES_DB=accounting
DATABASE_URL=postgresql+psycopg://accounting:changeme@localhost:5432/accounting
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_ON_STARTUP=true

SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=14
COOKIE_SECURE=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme

# --- Backups ---
# Directory (relative to repo root, or absolute) where scripts/backup.sh writes DB dumps.
BACKUP_DIR=backups
# Number of most-recent dumps to keep; older ones are pruned after each backup run.
BACKUP_RETENTION=20

# --- Frontend ---
VITE_API_BASE_URL=/api
