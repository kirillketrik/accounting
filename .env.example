# Single env file for the whole project. Copy to .env and adjust — defaults already work.
#
# Used by:
#   - the backend, when run manually (`cd backend && uv run uvicorn ...`)
#   - the frontend, when run manually (`cd frontend && npm run dev`)
#   - docker-compose.yml / docker-compose.dev.yml, which load this file (`env_file: .env`)
#     and pass its values into the backend/celery/frontend containers. A few values are
#     overridden per-service in the compose files where the containerized context needs a
#     different value (data paths, the `redis`/`backend` service hostnames, etc).

# --- Docker (prod) ---
# Port the app is published on for LAN colleagues, e.g. http://<this-machine-ip>:FRONTEND_PORT
# Change this if port 80 is already taken on the host.
FRONTEND_PORT=80

# --- Backend ---
APP_NAME="Asset Management API"
API_PREFIX=/api
# Credentials for the postgres service in docker-compose*.yml, and for DATABASE_URL below
# when running the backend manually against a local Postgres instance.
POSTGRES_USER=accounting
POSTGRES_PASSWORD=jWx2ypFH5ZXWvMK2mOq5tnlGAwC5LC3r
POSTGRES_DB=accounting
DATABASE_URL=postgresql+psycopg://accounting:jWx2ypFH5ZXWvMK2mOq5tnlGAwC5LC3r@localhost:5432/accounting
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SEED_ON_STARTUP=true

SESSION_COOKIE_NAME=session
SESSION_TTL_DAYS=14
COOKIE_SECURE=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme

BACKUPS_DIR=backups
BACKUP_RETENTION=20
# Symmetric key used to encrypt backup destination credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_CREDENTIALS_KEY=
REDIS_URL=redis://localhost:6379/0

# --- Frontend ---
VITE_API_BASE_URL=/api
